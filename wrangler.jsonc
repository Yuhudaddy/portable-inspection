// Cloudflare Workers（static assets）部署設定：純靜態網站，沒有 Worker 程式碼。
// Workers Builds 連結 GitHub 後，每次推 main 會自動執行 `wrangler deploy` 上傳這個目錄。
// 不上傳的檔案列在 .assetsignore；自訂 HTTP 標頭在 _headers。
{
  "name": "portable-inspection",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./",
    // 不要把 /xxx.html 轉址成 /xxx：App 內連結、Service Worker 快取鍵、manifest 都用 .html 網址，
    // 要和 GitHub Pages 行為一致。根路徑 / 由 _redirects 改寫成 index.html。
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "preview_urls": true
}
